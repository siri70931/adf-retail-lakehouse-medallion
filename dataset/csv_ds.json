{
	"name": "csv_ds",
	"properties": {
		"linkedServiceName": {
			"referenceName": "ADLS_LS",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"container": {
				"type": "string"
			},
			"folder": {
				"type": "string"
			},
			"file": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "DelimitedText",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().file",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().folder",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().container",
					"type": "Expression"
				}
			},
			"columnDelimiter": ",",
			"escapeChar": "\\",
			"firstRowAsHeader": true,
			"quoteChar": "\""
		},
		"schema": [
			{
				"name": "_id",
				"type": "String"
			},
			{
				"name": "name",
				"type": "String"
			},
			{
				"name": "email",
				"type": "String"
			},
			{
				"name": "movie_id",
				"type": "String"
			},
			{
				"name": "text",
				"type": "String"
			},
			{
				"name": "date",
				"type": "String"
			}
		]
	}
}