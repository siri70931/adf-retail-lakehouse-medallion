{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "actedatafactory"
		},
		"ADLS_LS_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ADLS_LS'"
		},
		"Destination_Sql_LinkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Destination_Sql_LinkedService'"
		},
		"FileServer1_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'FileServer1'"
		},
		"Source_sql_LinkedService_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'Source_sql_LinkedService'"
		},
		"ADLS_LS_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://actestoragegroup.dfs.core.windows.net/"
		},
		"Destination_Sql_LinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "actedbserver.database.windows.net"
		},
		"Destination_Sql_LinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "actedb"
		},
		"Destination_Sql_LinkedService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Admin123"
		},
		"FileServer1_properties_typeProperties_host": {
			"type": "string",
			"defaultValue": "C:\\Users\\pujig\\OneDrive\\Desktop\\ACTE\\Datasets"
		},
		"FileServer1_properties_typeProperties_userId": {
			"type": "string",
			"defaultValue": "pujitha\\pujitha"
		},
		"Source_sql_LinkedService_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "actedbserver.database.windows.net"
		},
		"Source_sql_LinkedService_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "actedb"
		},
		"Source_sql_LinkedService_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "Admin123"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "actedatafactory_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ADLS_LS_accountKey": {
						"value": "[parameters('ADLS_LS_accountKey')]"
					},
					"Destination_Sql_LinkedService_password": {
						"value": "[parameters('Destination_Sql_LinkedService_password')]"
					},
					"Source_sql_LinkedService_password": {
						"value": "[parameters('Source_sql_LinkedService_password')]"
					},
					"FileServer1_password": {
						"value": "[parameters('FileServer1_password')]"
					},
					"ADLS_LS_properties_typeProperties_url": {
						"value": "[parameters('ADLS_LS_properties_typeProperties_url')]"
					},
					"Destination_Sql_LinkedService_properties_typeProperties_server": {
						"value": "[parameters('Destination_Sql_LinkedService_properties_typeProperties_server')]"
					},
					"Destination_Sql_LinkedService_properties_typeProperties_database": {
						"value": "[parameters('Destination_Sql_LinkedService_properties_typeProperties_database')]"
					},
					"Destination_Sql_LinkedService_properties_typeProperties_userName": {
						"value": "[parameters('Destination_Sql_LinkedService_properties_typeProperties_userName')]"
					},
					"Source_sql_LinkedService_properties_typeProperties_server": {
						"value": "[parameters('Source_sql_LinkedService_properties_typeProperties_server')]"
					},
					"Source_sql_LinkedService_properties_typeProperties_database": {
						"value": "[parameters('Source_sql_LinkedService_properties_typeProperties_database')]"
					},
					"Source_sql_LinkedService_properties_typeProperties_userName": {
						"value": "[parameters('Source_sql_LinkedService_properties_typeProperties_userName')]"
					},
					"FileServer1_properties_typeProperties_host": {
						"value": "[parameters('FileServer1_properties_typeProperties_host')]"
					},
					"FileServer1_properties_typeProperties_userId": {
						"value": "[parameters('FileServer1_properties_typeProperties_userId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}